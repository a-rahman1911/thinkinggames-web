# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Any long random string. Must match the secret on the Sanity webhook.
SANITY_REVALIDATE_SECRET=
# Server only, never NEXT_PUBLIC. Needed only by `npm run import:games` (Sanity → API → Tokens, Editor role).
SANITY_WRITE_TOKEN=
